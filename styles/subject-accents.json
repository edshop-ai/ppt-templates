{
  "$comment": "Two axes. SUBJECT picks the hue; BAND picks the treatment (chroma and page lightness). Resolve a palette by: 1) look up subjects[subject].hue, 2) find the treatment whose bands[] contains the grade band, 3) read treatments[t].palettes[hue]. band_overrides wins over both when present. Every value is literal hex, so the generator never computes color.",
  "schema_version": 2,
  "resolution_order": [
    "band_overrides[band][subject]",
    "treatments[t].palettes[ subjects[subject].hue ]",
    "treatments.academic.palettes.blue"
  ],
  "constant": {
    "panel": "#FFFFFF",
    "text_primary": "#14181F",
    "text_secondary": "#414A57",
    "on_accent": "#FFFFFF",
    "$note": "panel, text_primary, text_secondary and on_accent never vary by subject or band."
  },
